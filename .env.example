# Copy to .env and adjust. Every value here has a working default.

# Flask session signing key. Leave it unset and one is generated on first run
# and stored in data/instance/secret_key. Only set it here if several machines
# have to share sessions.
# SECRET_KEY=

# Where training projects live. Defaults to <repo>/data/projects.
# PROJECTS_ROOT=D:/vision-datasets

# Ports. The Vite dev server proxies /api to BACKEND_PORT.
BACKEND_PORT=64031
FRONTEND_PORT=64030

# Interface the API binds to. Loopback by default. Set 0.0.0.0 to let other
# machines reach it — and change the admin password first.
BACKEND_HOST=127.0.0.1

# Interface the Vite dev server binds to. It already listens on every
# interface; set 127.0.0.1 to restrict it to this machine.
# FRONTEND_HOST=0.0.0.0

# Werkzeug's debugger runs arbitrary code from the browser. Leave this off.
FLASK_DEBUG=0

# Set to 0 to open the API without a login (single-user local machine only).
REQUIRE_AUTH=1

# First-run administrator account. Only used when the database has no users.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@vision-training.local
# ADMIN_PASSWORD=choose-something-real
