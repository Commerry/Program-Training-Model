{
  "name": "vision-training-frontend",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Vue frontend for the Vision Training Platform",
  "scripts": {
    "dev": "vite",
    "dev:full": "concurrently --kill-others --names \"API,WEB\" -c \"blue.bold,magenta.bold\" \"npm run backend\" \"vite\"",
    "backend": "python ../backend/app.py",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "fabric": "^5.3.0",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.11",
    "concurrently": "^9.1.2",
    "happy-dom": "^15.11.7",
    "playwright": "^1.62.1",
    "vite": "^6.0.7",
    "vitest": "^2.1.9"
  }
}
